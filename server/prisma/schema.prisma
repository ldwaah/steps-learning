// Local dev: SQLite. Production: copy schema.postgresql.prisma before deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  STAFF
  DSL
  SCHOOL_ADMIN
  TRUST_ADMIN
}

enum TeamColour {
  RED
  BLUE
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

model Trust {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  schools   School[]
  users     User[]   @relation("TrustUsers")
}

model School {
  id          String   @id @default(cuid())
  trustId     String?
  trust       Trust?   @relation(fields: [trustId], references: [id], onDelete: SetNull)
  name        String
  slug        String   @unique
  city        String
  postcode    String
  inviteToken String   @unique
  createdAt   DateTime @default(now())
  users       User[]   @relation("SchoolUsers")
}

model User {
  id            String         @id @default(cuid())
  trustId       String?
  trust         Trust?         @relation("TrustUsers", fields: [trustId], references: [id])
  schoolId      String?
  school        School?        @relation("SchoolUsers", fields: [schoolId], references: [id])
  role          UserRole       @default(STUDENT)
  username      String
  pinHash       String
  firstName     String
  city          String?
  postcode      String?
  yearGroup     Int?
  teamColour    TeamColour?
  accountStatus AccountStatus  @default(APPROVED)
  points        Int            @default(0)
  level         String         @default("Getting started")
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  topicProgress      TopicProgress[]
  checkIns           CheckIn[]
  regulateLogs       RegulateLog[]
  auditEvents        AuditEvent[]
  sessionCompletions SessionCompletion[]

  @@unique([schoolId, username])
  @@index([trustId])
  @@index([schoolId, role])
  @@index([schoolId, accountStatus])
  @@index([schoolId, teamColour])
}

model TopicProgress {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId           String
  completedBlockIds String
  currentBlockId    String
  stepIndex         Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@unique([userId, topicId])
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  mood      String
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model RegulateLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model AuditEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  category    String
  summary     String
  detail      String?
  pointsDelta Int?
  meta        String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model SessionCompletion {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId         String
  blockId         String
  blockTitle      String
  startedAt       DateTime
  completedAt     DateTime
  durationMs      Int
  stepsTotal      Int
  quizRequired    Boolean
  quizPassed      Boolean
  quizScore       Int?
  quizTotal       Int?
  pointsTotal     Int      @default(0)
  pointsBase      Int      @default(0)
  pointsTimeBonus Int      @default(0)
  pointsAwarded   Boolean
  blockReason     String?
  schoolId        String?
  createdAt       DateTime @default(now())

  @@index([userId, completedAt])
  @@index([schoolId])
  @@index([completedAt])
}
