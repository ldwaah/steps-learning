{
  "name": "steps-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "db:prod:push": "cp prisma/schema.postgresql.prisma prisma/schema.prisma && prisma generate && prisma db push --accept-data-loss",
    "db:prod:seed": "tsx prisma/seed.ts",
    "db:prod:setup": "npm run db:prod:push && npm run db:prod:seed",
    "db:wipe": "tsx scripts/wipe-db.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "hono": "^4.7.11",
    "jose": "^6.0.11",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  }
}
